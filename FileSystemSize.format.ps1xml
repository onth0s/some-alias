<?xml version="1.0" encoding="utf-8"?>
<!--
  Default console table for files and directories: shows a human-readable
  "Size" column (rendered by Format-FileSize from the profile) alongside the
  raw byte "Length". Timestamps are MM/dd/yyyy HH:mm (everything
  zero-padded, no seconds); each cell is padded with a trailing space for a comfortable
  gap between columns. Formatting-only: the objects on the pipeline still
  carry the raw byte Length, so piping/scripting is unaffected.

  This is the fallback view (and the one Get-ChildItem/dir use). Plain `ls`
  console output draws its own fixed-width table with exactly two spaces
  between every column; this view stays for piped objects and raw
  Get-ChildItem.

  Loaded by the profile via:
    Update-FormatData -PrependPath (Join-Path $PSScriptRoot 'FileSystemSize.format.ps1xml')
-->
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>FileSystemInfo human-readable size</Name>
      <ViewSelectedBy>
        <TypeName>System.IO.FileInfo</TypeName>
        <TypeName>System.IO.DirectoryInfo</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader>
            <Label>Mode</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>LastWriteTime</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Size</Label>
            <Alignment>Right</Alignment>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Length</Label>
            <Alignment>Right</Alignment>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Name</Label>
          </TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem>
                <ScriptBlock>"$($_.Mode) "</ScriptBlock>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>'{0:MM/dd/yyyy HH:mm} ' -f $_.LastWriteTime</ScriptBlock>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>if ($_.PSIsContainer) { '&lt;DIR&gt; ' } else { (Format-FileSize $_.Length) + ' ' }</ScriptBlock>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>if ($_.PSIsContainer) { ' ' } else { "$($_.Length) " }</ScriptBlock>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>Name</PropertyName>
              </TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
  </ViewDefinitions>
</Configuration>